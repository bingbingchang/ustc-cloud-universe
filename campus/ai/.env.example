# Copy to .env in this directory. Never commit your key or put it in Godot.
# All 15 NPCs and the K-key action guide use this server-side configuration.
AI_PROVIDER=ustc
USTC_BASE_URL=https://api.llm.ustc.edu.cn/v1
# Use the exact model ID authorized for your project (GET /v1/models).
USTC_MODEL=deepseek-v4-flash
USTC_API_KEY=

EMBEDDING_DEVICE=cpu
MODEL_MAX_CONCURRENCY=2
MODEL_CALLS_PER_MINUTE=10
# Web relay only. Generate a separate random token; never reuse the model key.
CAMPUS_RELAY_TOKEN=
CAMPUS_WEB_SITE_URL=
# Optional local model location; otherwise load the official HF model ID.
# EMBEDDING_MODEL_PATH=/workspace/campus-ai/models/Qwen3-Embedding-0.6B

# Optional legacy local generation service: set AI_PROVIDER=qwen explicitly.
# QWEN_BASE_URL=http://127.0.0.1:8000/v1
# QWEN_MODEL=Qwen/Qwen3-8B
# QWEN_API_KEY=
