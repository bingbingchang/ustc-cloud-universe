config_version=5

[application]
config/name="科大云宇宙 | USTC Cloud Universe"
config/version="0.2.0-dev"
run/main_scene="res://scenes/campus_game.tscn"
run/main_scene.web="res://scenes/campus_web.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
CampusMusic="*res://scripts/background_music.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/size/viewport_width.web=960
window/size/viewport_height.web=540

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_taa.web=false
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4
occlusion_culling/use_occlusion_culling=true
occlusion_culling/use_occlusion_culling.web=false

[physics]
common/physics_ticks_per_second=60
